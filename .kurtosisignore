# Kurtosis uploads this directory on every run and does NOT honour .gitignore, so build
# output has to be excluded here too: `make bin` writes tens of megabytes into bin/, which
# has nothing to do with the package and only slows the upload.
bin/
artifacts/
**/*.log
# `go build ./cmd/<x>/` drops the binary in the repo root; a 10MB upload per stray one.
/pbtchaos
/pbtmonitor
/pbthammer
/gengenesis
/migration-*
/verify-migration

# The repository history is the largest thing here by far and the package never reads it.
.git/
