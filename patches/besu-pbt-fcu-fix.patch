@@ -127,7 +127,20 @@ public class BinaryStateRootCommitter implements StateRootCommitter {
       if (!storageFrozen) {
         stateTrie.commit(
             (location, hash, value) ->
-                writes.add(updater -> updater.putTrieNode(location, hash, value)));
+                writes.add(
+                    updater -> {
+                      // The partitioned binary trie signals "the node at this location is
+                      // gone" by storing a null hash and value (CommitVisitor.visit for
+                      // EmptyTrieNode), which is how a collapsed subtree clears the bytes a
+                      // previous commit wrote at that path. Updater.putTrieNode cannot take
+                      // that: it starts with nodeHash.equals(EMPTY_TRIE_NODE_HASH) and
+                      // throws NullPointerException. Route deletions to removeTrieNode.
+                      if (hash == null || value == null) {
+                        updater.removeTrieNode(location);
+                      } else {
+                        updater.putTrieNode(location, hash, value);
+                      }
+                    }));
       }
       writeSink.addAll(writes);
