#!/bin/sh
# Offline-migration hook for the pbt-devnet lap. cmd/migration-swap stops this
# node, drops an EIP-8347 snapshot and preimage file into pbt-swap/ beside a
# `flags` file, and starts it again: geth imports the pair in the background
# while it keeps following the chain (--pbt.import.*), and its follower adopts
# the anchor once the import attests. The flags are kept, so every later
# restart finds the import done and reuses it.
# Without the file this is the client itself.
D=/data/geth/execution-data
S=$D/pbt-swap
if [ -f "$S/flags" ]; then
  # One flag per line, none holding a space.
  extra=$(cat "$S/flags")
  echo "pbt-swap: starting with" $extra
  # shellcheck disable=SC2086 # the flags split on purpose
  exec geth.real "$@" $extra
fi
exec geth.real "$@"
