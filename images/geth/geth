#!/bin/sh
# Offline-migration hook for the pbt-devnet lap. cmd/migration-swap stops this
# node and drops a `flags` file into pbt-swap/, then starts it again. In the
# default (import) geth-swap mode the dir also holds a snapshot+preimage pair
# and the flags name both (--pbt.import.snapshot/.preimages/.anchor); in
# convert mode (GETH_SWAP=convert) it holds only the producer's preimage file
# and the flags name just that and the anchor, so geth converts its own
# persisted state instead. Either way geth keeps following the chain while it
# works (--pbt.import.*) and its follower adopts the anchor once it attests.
# The flags are kept, so every later restart finds the work done and reuses it.
# Without the file this is the client itself.
D=/data/geth/execution-data
S=$D/pbt-swap
if [ -f "$S/flags" ]; then
  # One flag per line, none holding a space.
  extra=$(cat "$S/flags")
  echo "pbt-swap: starting with" $extra
  # shellcheck disable=SC2086 # the flags split on purpose
  exec geth.real "$@" $extra
fi
exec geth.real "$@"
